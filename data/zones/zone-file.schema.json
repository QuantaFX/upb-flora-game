{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upb-flora-game.local/schema/zone-file.schema.json",
  "title": "ZoneFile",
  "description": "A playable zone: terrain and prop grids plus spawn nodes. Nodes validate against flora-node.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "width", "height", "tileset", "terrain", "props", "collision", "entries", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^zone_[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 3 },
    "description": { "type": "string" },
    "width": { "type": "integer", "minimum": 8, "maximum": 128 },
    "height": { "type": "integer", "minimum": 8, "maximum": 128 },
    "tileset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tilePx", "elevationStepPx"],
      "properties": {
        "id": { "type": "string" },
        "tilePx": { "type": "integer", "const": 16 },
        "elevationStepPx": { "type": "integer", "const": 8 }
      }
    },
    "terrain": {
      "type": "array",
      "description": "Row-major char grid, height rows of width chars. Chars are keys into tileLegend.",
      "items": { "type": "string" }
    },
    "tileLegend": {
      "type": "object",
      "description": "Map from a terrain char to the generated tile id and the elevation of that tile.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tile", "elevation"],
        "properties": {
          "tile": { "type": "string", "enum": ["grass", "path_stone", "stairs_up", "stairs_down", "wall_stone", "moss"] },
          "elevation": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    },
    "props": {
      "type": "array",
      "description": "Row-major char grid for props. '.' is empty; other chars are keys into propLegend.",
      "items": { "type": "string" }
    },
    "propLegend": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prop", "solid"],
        "properties": {
          "prop": { "type": "string", "enum": ["pine_trunk", "pine_canopy", "bench", "gate", "guide"] },
          "solid": { "type": "boolean" },
          "overlay": { "type": "boolean", "description": "Drawn with the row below its tile so the player passes under it." }
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbiddenTiles", "blockedFurniture"],
      "properties": {
        "forbiddenTiles": { "type": "array", "items": { "type": "string" } },
        "blockedFurniture": { "type": "array", "items": { "type": "string" } },
        "walkableRule": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tile", "elevation", "facing"],
        "properties": {
          "tile": { "$ref": "#/$defs/tile" },
          "elevation": { "type": "integer", "minimum": 0, "maximum": 3 },
          "facing": { "type": "string", "enum": ["down", "up", "left", "right"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "../flora-node.schema.json" }
    }
  },
  "$defs": {
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    }
  }
}